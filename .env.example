# Optional: server-side AI shopping assistant. Never put keys in VITE_ variables.
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
# Optional shared demo gate: set DEMO_PASSWORD to at least 16 characters.
# Configure it securely in .env or hosting settings; do not commit its value.
# Docker/Railway persistent storage: DATABASE_PATH=/var/data/commerce.sqlite
# PUBLIC_APP_URL must be the actual public HTTPS service origin for Stripe.
PUBLIC_APP_URL=
STRIPE_SECRET_KEY=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_WEBHOOK_SECRET=
SHIPPING_COUNTRIES=US
STRIPE_AUTOMATIC_TAX=false
# Docker Compose binds to loopback port 8080 by default.
MYVERSE_HTTP_PORT=8080
# Defaults: PORT=3001, HOST=127.0.0.1; SQLite persists in .data/commerce.sqlite.
